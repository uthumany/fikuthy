{
  "name": "@fikuthy/terminal-ui",
  "version": "0.2.13",
  "private": true,
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@11.19.0",
  "description": "Reference-matched Fikuthy terminal UI built with React and Ink",
  "type": "module",
  "bin": {
    "fikuthy-ui": "dist/index.js"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:package": "node test/package-smoke.mjs",
    "screenshots": "python3 test/pty_capture.py && python3 test/ansi_to_png.py screenshots/*.ansi"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "cli-spinners": "^3.4.0",
    "execa": "^10.0.1",
    "figures": "^6.1.0",
    "gradient-string": "^3.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "react-devtools-core": "^7.0.1",
    "string-width": "^8.2.2",
    "wrap-ansi": "^10.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
