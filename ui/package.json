{
  "name": "@utharness/terminal-ui",
  "version": "0.2.13",
  "private": true,
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@11.19.0",
  "description": "Reference-matched Utharness terminal UI built with React and Ink",
  "type": "module",
  "bin": {
    "utharness-ui": "dist/index.js"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:package": "node test/package-smoke.mjs",
    "screenshots": "python3 test/pty_capture.py && python3 test/ansi_to_png.py screenshots/*.ansi"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "chalk": "^5.4.1",
    "chokidar": "^4.0.3",
    "cli-spinners": "^2.9.2",
    "execa": "^9.5.2",
    "figures": "^6.1.0",
    "gradient-string": "^3.0.0",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "react-devtools-core": "^4.19.1",
    "string-width": "^7.2.0",
    "wrap-ansi": "^9.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
